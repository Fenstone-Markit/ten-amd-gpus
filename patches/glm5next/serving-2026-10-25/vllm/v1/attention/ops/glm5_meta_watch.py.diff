+def meta_watch_build_b(seq_lens, query_start_loc, sparse_seqlen, paged_kv_indptr,
+                       num_reqs, num_tokens, topk_tokens, window):
+    # Checkpoint (b): just after the cumsum into paged_kv_indptr. Synchronise,
+    # print the values the build saw (with device addresses) and store a CPU
+    # reference of paged_kv_indptr[:num_tokens+1]. No new device allocation.
+    if not _enabled():
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    try:
+        torch.cuda.synchronize()
+    except Exception:
+        return
+    global _W_BUILD_COUNT, _W_LAST_REF, _W_LAST_NTOK, _W_RISING, _W_INDPR_BUF, _W_C_DIFF_BUILT
+    r = _rank()
+    _W_BUILD_COUNT += 1
+    _W_C_DIFF_BUILT = False  # new build -> allow one (c) difference report
+    # [glm5next-port-24] Part 2: print the H2D copy count at a start-up marker
+    # (build #5) so we have the count even when no fault occurs.
+    if _W_BUILD_COUNT == 5:
+        try:
+            print("[GLM5_SYNC_H2D] H2D_COPY_COUNT at startup (build #5) = %d (rank=%d, enabled=%s)"
+                  % (h2d_count(), r, _h2d_enabled()), flush=True)
+        except Exception:
+            pass
+    n_indptr = num_tokens + 1
+    seq = _host(seq_lens, num_reqs)
+    qsl = _host(query_start_loc, num_reqs + 1)
+    sseql = _host(sparse_seqlen, num_tokens)
+    ind = _host(paged_kv_indptr, n_indptr)
+    if ind is None:
+        return
+    rising = all(ind[i] <= ind[i + 1] for i in range(len(ind) - 1))
+    _W_RISING = rising
+    # print policy: first five builds per worker, always when out of range
+    first5 = _W_BUILD_COUNT <= 5
+    oor = (
+        (seq is not None and (min(seq) < 0 or max(seq) > window))
+        or (sseql is not None and (min(sseql) < 0 or max(sseql) > topk_tokens))
+        or (not rising)
+        or (ind[-1] > num_tokens * topk_tokens)
+    )
+    if first5 or oor:
+        print("[GLM5_META_WATCH b] rank=%d build#=%d num_reqs=%d num_tokens=%d "
+              "topk=%d window=%d" % (r, _W_BUILD_COUNT, num_reqs, num_tokens,
+                                     topk_tokens, window), flush=True)
+        print("[GLM5_META_WATCH b]   seq_lens[:num_reqs]=%s ptr=%s" % (seq, _ptr(seq_lens)), flush=True)
+        print("[GLM5_META_WATCH b]   query_start_loc[:num_reqs+1]=%s ptr=%s" % (qsl, _ptr(query_start_loc)), flush=True)
+        print("[GLM5_META_WATCH b]   sparse_seqlen[:num_tokens]=%s ptr=%s" % (sseql, _ptr(sparse_seqlen)), flush=True)
+        print("[GLM5_META_WATCH b]   paged_kv_indptr[:num_tokens+1]=%s ptr=%s rising=%s" % (ind, _ptr(paged_kv_indptr), rising), flush=True)
+        # [glm5next-port-24] Part 1 backup: the e2 checkpoints did not catch it but the
+        # build's own values are out of range -> run the forensic once.
+        if oor and not _P1_FIRED:
+            _p1_fire(r, seq_lens)
+    _W_LAST_REF = ind
+    _W_LAST_NTOK = num_tokens
+    # Keep a reference to the full GPU buffer so later checkpoints (c) can
+    # re-read it and compare against the reference. No new allocation.
+    try:
+        if isinstance(paged_kv_indptr, torch.Tensor) and paged_kv_indptr.is_cuda:
+            _W_INDPR_BUF = paged_kv_indptr
+    except Exception:
+        pass
+
