+def meta_watch_a(seq_lens_host, seq_lens_dev, qsl_host, qsl_dev, num_reqs, num_tokens):
+    # Checkpoint (a): just after seq_lens and query_start_loc are copied to the
+    # GPU in _dummy_run. Synchronise, then print the host values written and the
+    # device values read back for seq_lens[:num_reqs] and query_start_loc[:num_reqs+1].
+    if not _enabled():
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    try:
+        torch.cuda.synchronize()
+    except Exception:
+        return
+    sl_h = _host(seq_lens_host, num_reqs)
+    sl_d = _host(seq_lens_dev, num_reqs)
+    q_h = _host(qsl_host, num_reqs + 1)
+    q_d = _host(qsl_dev, num_reqs + 1)
+    print("[GLM5_META_WATCH a] rank=%d num_reqs=%d num_tokens=%d" % (_rank(), num_reqs, num_tokens), flush=True)
+    print("[GLM5_META_WATCH a]   seq_lens host=%s  device=%s  devptr=%s" % (sl_h, sl_d, _ptr(seq_lens_dev)), flush=True)
+    print("[GLM5_META_WATCH a]   query_start_loc host=%s  device=%s  devptr=%s" % (q_h, q_d, _ptr(qsl_dev)), flush=True)
+
