+def meta_watch_check_e2(checkpoint, sl_dev, qsl_dev):
+    # Checkpoint (e2) [Part 2]: compare the device seq_lens and query_start_loc
+    # against the host-staged expected values (set via meta_watch_set_expected).
+    # Reports the first step after which either buffer is wrong. Off by default.
+    global _W_E_DEBUG
+    if not _enabled():
+        return
+    if torch.cuda.is_current_stream_capturing():
+        if not _W_E_DEBUG:
+            _W_E_DEBUG = True
+            print("[GLM5_META_WATCH e] %s SKIPPED: stream capturing" % checkpoint, flush=True)
+        return
+    if not _W_EXP_SL:
+        print("[GLM5_META_WATCH e] %s SKIPPED: no expected (set_expected didn't run?)"
+              % checkpoint, flush=True)
+        return
+    try:
+        torch.cuda.synchronize()
+        n = min(len(_W_EXP_SL), sl_dev.numel())
+        cur = sl_dev[:n].detach().cpu().tolist()
+        # [glm5next-port-24] Part 1: at checkpoint e6 (last known good), capture the
+        # whole segment holding seq_lens as the reference for the (ii) diff. Replace
+        # it every build.
+        if "e6" in checkpoint and not _P1_FIRED:
+            _p1_capture_e6_ref(sl_dev)
+    except Exception as e:
+        print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s seq_lens read FAILED %r"
+              % (_rank(), checkpoint, e), flush=True)
+        return
+    for i in range(n):
+        if cur[i] != _W_EXP_SL[i]:
+            print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s seq_lens FIRST WRONG at index=%d "
+                  "expected=%d (0x%X) actual=%d (0x%X) devptr=%s"
+                  % (_rank(), checkpoint, i, _W_EXP_SL[i], _W_EXP_SL[i],
+                     cur[i], cur[i], _ptr(sl_dev)), flush=True)
+            _p1_fire(_rank(), sl_dev)
+            return
+    # seq_lens OK (matches expected)
+    print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s seq_lens OK devptr=%s"
+          % (_rank(), checkpoint, _ptr(sl_dev)), flush=True)
+    if qsl_dev is not None:
+        try:
+            nq = min(len(_W_EXP_QSL), qsl_dev.numel())
+            curq = qsl_dev[:nq].detach().cpu().tolist()
+        except Exception as e:
+            curq = None
+            print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s qsl read FAILED %r"
+                  % (_rank(), checkpoint, e), flush=True)
+        if curq is not None:
+            for i in range(nq):
+                if curq[i] != _W_EXP_QSL[i]:
+                    print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s query_start_loc FIRST WRONG at index=%d "
+                          "expected=%d (0x%X) actual=%d (0x%X) devptr=%s"
+                          % (_rank(), checkpoint, i, _W_EXP_QSL[i], _W_EXP_QSL[i],
+                             curq[i], curq[i], _ptr(qsl_dev)), flush=True)
+                    _p1_fire(_rank(), sl_dev)
+                    return
+            print("[GLM5_META_WATCH e] rank=%d CHECKPOINT=%s query_start_loc OK devptr=%s"
+                  % (_rank(), checkpoint, _ptr(qsl_dev)), flush=True)
+
