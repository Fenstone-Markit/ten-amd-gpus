+def meta_watch_check_c(checkpoint, indptr, num_tokens, topk_tokens):
+    # Checkpoint (c): compare paged_kv_indptr[:num_tokens+1] against the build
+    # reference; on the first difference after a build, print the checkpoint,
+    # first differing index, and old/new values (dec + hex). Reports only the
+    # FIRST difference per build (so (a)/(b) order + layer + before-kernel are
+    # the meaningful sequence). Returns True if a difference was found.
+    global _W_C_DIFF_BUILT
+    if not _enabled():
+        return False
+    if torch.cuda.is_current_stream_capturing():
+        return False
+    if _W_LAST_REF is None:
+        return False
+    if _W_C_DIFF_BUILT:
+        # already reported a difference for the current build
+        return False
+    try:
+        torch.cuda.synchronize()
+    except Exception:
+        return False
+    n = min(len(_W_LAST_REF), num_tokens + 1)
+    ind = _host(indptr, n)
+    if ind is None:
+        return False
+    for i in range(n):
+        if ind[i] != _W_LAST_REF[i]:
+            _W_C_DIFF_BUILT = True
+            print("[GLM5_META_WATCH c] rank=%d CHECKPOINT=%s FIRST DIFF at index=%d "
+                  "old=%d (0x%X) new=%d (0x%X)  [build#=%d, |indptr|=%d]"
+                  % (_rank(), checkpoint, i, _W_LAST_REF[i], _W_LAST_REF[i],
+                     ind[i], ind[i], _W_BUILD_COUNT, n), flush=True)
+            return True
+    return False
