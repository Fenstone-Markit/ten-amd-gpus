+        # [glm5-mem-trace] GLM5_MEM_TRACE=1: dump the alloc/free event timeline
+        # of the start-up measurement and name the transient (freed)
+        # window-scaled tensors. The transient is freed by this point, so the
+        # live snapshot misses it; the event timeline keeps it with its stack.
+        if _mem_trace_on:
+            try:
+                import pickle as _pickle
+                _tmp = f"/tmp/memtrace_{os.getpid()}.pkl"
+                torch.cuda.memory._dump_snapshot(_tmp)
+                torch.cuda.memory._record_memory_history(False)
+                _peak = torch.cuda.memory_stats().get(
