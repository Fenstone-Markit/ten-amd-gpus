+    # --- [glm5next-port-12] forced eager break ----------------------------
+    def force_eager(self, fn: Callable[[], Any]) -> Any:
+        """Run ``fn`` as a REAL eager break, independent of the forward
+        context's cudagraph runtime mode.
+
+        ``add_eager`` already does the right thing (end segment, run ``fn``
+        eagerly on the capture stream, record it for replay, start a new
+        segment); the problem is that the ``eager_break_during_capture``
+        decorator short-circuits to a plain ``fn(...`` call when the runtime
+        mode is FULL, so the break never happens. This method is called
+        directly by the DSA wrapper (via the GLM5_DSA_BREAK switch) to force
+        the break regardless of mode.
+
+        At capture: ends the segment, runs ``fn`` eagerly on the capture
+        stream, records ``fn`` for replay, starts a new segment, returns the
+        result. At replay: the recorded ``fn`` is replayed in order by
+        :meth:`replay` (it runs eagerly between the graph segments).
+
+        If there is no active capture (not capturing), it just runs ``fn``
+        normally and returns the result (this is the eager / no-graph path).
+        """
+        if not self._capturing:
+            return fn()
+        return self.add_eager(fn)
+
