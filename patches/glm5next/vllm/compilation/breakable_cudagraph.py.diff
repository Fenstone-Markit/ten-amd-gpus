+# ---------------------------------------------------------------------------
+# [glm5next-port-12] GLM5_DSA_BREAK forced-eager-break switch.
+#
+# Off by default. When set to "indexer" / "attn" / "both", the named part of the
+# DSA decode is forced to run as a REAL eager break inside a FULL decode graph:
+# at capture it is executed outside the (stream) capture via
+# BreakableCUDAGraphCapture.add_eager, and at every replay it is re-executed
+# eagerly between the graph segments. This is only possible because our FULL
+# decode graph is captured through BreakableCUDAGraphCapture (breakable is
+# auto-enabled for GLM; see config/vllm.py:1233-1255). See the mla.py wrapper,
+# which calls BreakableCUDAGraphCapture.current().force_eager(...).
+# ---------------------------------------------------------------------------
+_DSA_BREAK_REGISTRY: list[str] = []
+
+
+def glm5_dsa_break_parts() -> set[str]:
+    """Return the set of named DSA parts forced to eager breaks.
+
+    Values of the GLM5_DSA_BREAK env var: "indexer", "attn", "both" (or any
+    non-empty string; unrecognised values are logged once and treated as
+    "both" so the switch is never silently ignored). Empty / unset -> off.
+    """
+    v = (os.environ.get("GLM5_DSA_BREAK", "") or "").strip().lower()
+    if not v:
+        return set()
+    if v == "indexer":
+        return {"indexer"}
+    if v == "attn":
+        return {"attn"}
+    if v == "both":
+        return {"indexer", "attn"}
+    logger.warning_once(
+        "GLM5_DSA_BREAK=%r is not one of indexer/attn/both; treating as both.",
+        v,
+    )
+    return {"indexer", "attn"}
+
+
+def _dsa_break_log_parts() -> None:
+    """Log the break switch once, at startup (first call)."""
+    if _DSA_BREAK_REGISTRY:
+        return
+    parts = glm5_dsa_break_parts()
+    if parts:
+        _DSA_BREAK_REGISTRY.extend(sorted(parts))
+        logger.info(
+            "[glm5-dsa-break] GLM5_DSA_BREAK=%s: forcing these DSA decode parts "
+            "to real eager breaks inside the FULL decode graph: %s",
+            sorted(parts), ", ".join(sorted(parts)),
+        )
+    else:
+        _DSA_BREAK_REGISTRY.append("off")
+        logger.info(
+            "[glm5-dsa-break] GLM5_DSA_BREAK not set: no forced DSA breaks "
+            "(switch off)."
+        )
+
+
 F = TypeVar("F", bound=Callable[..., Any])
 
 
